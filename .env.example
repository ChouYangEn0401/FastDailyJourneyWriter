# Copy to .env and fill in. .env is gitignored.

# Optional. Without it the app still works fully — the HTML artifact, the SVG
# card and a basic drawing prompt are all generated deterministically.
# With it, the three AI features are enabled.
ANTHROPIC_API_KEY=

# Model used for the AI features.
JOURNAL_MODEL=claude-opus-5

# Where the SQLite DB and exports live (gitignored).
JOURNAL_DATA_DIR=data
