{
  "id": "three-part",
  "name": "三段式（反省・靈修・代禱）",
  "description": "一段一個顏色：反省藍、靈修綠、代禱紅。手寫本常見的分法。",
  "group": "與神同行",
  "order": 1,
  "default_theme": "notebook",
  "default_layout": "manuscript",
  "sections": [
    {
      "id": "reflect",
      "title": "每日反省",
      "color": "#2456b8",
      "icon": "①",
      "fields": [
        {
          "id": "highlight",
          "label": "今天發生了什麼",
          "placeholder": "今天…",
          "color": "#2456b8"
        },
        {
          "id": "learned",
          "label": "我學到 / 我看見自己",
          "placeholder": "我發現我…",
          "color": "#2456b8"
        }
      ]
    },
    {
      "id": "devotion",
      "title": "靈修",
      "color": "#1f7a4d",
      "icon": "②",
      "fields": [
        {
          "id": "passage",
          "label": "經文進度",
          "kind": "short_text",
          "placeholder": "例：約伯記 33-34 章"
        },
        {
          "id": "observe",
          "label": "觀察：這段在說什麼",
          "color": "#1f7a4d"
        },
        {
          "id": "apply",
          "label": "應用：那我要怎麼做",
          "color": "#c8322c"
        }
      ]
    },
    {
      "id": "pray",
      "title": "代禱",
      "color": "#c8322c",
      "icon": "③",
      "fields": [
        {
          "id": "prayer",
          "label": "代禱事項",
          "kind": "list",
          "placeholder": "求主…",
          "min_rows": 4,
          "color": "#c8322c"
        },
        {
          "id": "gratitude",
          "label": "感恩事項",
          "kind": "list",
          "placeholder": "感謝神…",
          "color": "#1f7a4d"
        }
      ]
    }
  ]
}
